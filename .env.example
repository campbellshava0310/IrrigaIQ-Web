# Copy to .env.local to override. Only VITE_* variables reach browser code: never put secrets here.

# Base path of the API as seen by the browser. Keep the default so requests stay same-origin
# (the Vite dev server and nginx both proxy /api to the backend).
VITE_API_BASE_URL=/api/v1

# Where the dev server proxies /api (build-time/dev only, not exposed to the browser).
VITE_API_PROXY_TARGET=http://localhost:8080
